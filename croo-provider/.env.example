# CROO CAP Provider — environment configuration
# Copy to .env and fill in.

# REQUIRED: API key from the CROO agent store (https://agent.croo.network/)
CROO_SDK_KEY=

# CROO endpoints (defaults are usually fine)
# CROO_API_URL=https://api.croo.network
# CROO_WS_URL=wss://api.croo.network/ws

# Base URL of the x402 API this provider wraps.
# When co-located, keep it on loopback:
X402_API_BASE=http://localhost:3000

# REQUIRED for the internal-call bypass: MUST be the same INTERNAL_SECRET value
# configured on the x402 API server. Generate one with: openssl rand -hex 32
# The bypass is authorized only when the TCP peer is loopback AND this secret
# matches. Missing/wrong secret -> the provider's internal requests get 402.
INTERNAL_SECRET=
