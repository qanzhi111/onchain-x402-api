# OnChain Shadow x402 API — environment configuration
# Copy to .env and fill in. Never commit the real .env.

# REQUIRED: Base-mainnet USDC recipient wallet (收款地址)
WALLET_ADDRESS=0x801B27e126d91D99A70cd31ffc8BC867B329023D

# Port (Render sets PORT automatically)
PORT=3000

# Payment verification mode:
#   onchain     -> no third party; verify/simulate/broadcast/confirm via public Base RPCs (recommended for mainnet)
#   facilitator -> verify via FACILITATOR_URL (the public x402.org facilitator is TESTNET-ONLY)
PAYMENT_MODE=onchain

# Shared secret authorizing internal loopback callers (e.g. croo-provider).
# REQUIRED for the internal bypass; use a long random value, e.g.
#   openssl rand -hex 32
# If unset, the server generates an ephemeral random secret at startup.
INTERNAL_SECRET=

# OPTIONAL (facilitator mode only): self-hosted facilitator /verify URL.
# Default https://x402.org/facilitator/verify does NOT support Base mainnet.
FACILITATOR_URL=

# OPTIONAL: comma-separated Base RPC endpoints (used in onchain mode, fallback order)
# BASE_RPC_URLS=https://mainnet.base.org,https://base.publicnode.com

# OPTIONAL upstream API keys
COINGECKO_API_KEY=
ETHERSCAN_API_KEY=
